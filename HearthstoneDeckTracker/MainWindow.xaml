<Window x:Class="HearthstoneDeckTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone Deck Tracker"
        Height="540" Width="660"
        MinHeight="480" MinWidth="580"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0A14" Offset="0"/>
            <GradientStop Color="#12101C" Offset="0.5"/>
            <GradientStop Color="#0A0D18" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Gold accent color -->
        <SolidColorBrush x:Key="GoldBrush" Color="#D4AF37"/>
        <SolidColorBrush x:Key="GoldLightBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="DarkPanelBrush" Color="#1A1628"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#0F0D1A"/>

        <!-- Primary Button Style -->
        <Style x:Key="HsButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gold Button -->
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource HsButton}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C9A227" Offset="0"/>
                        <GradientStop Color="#8B6914" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue Button -->
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource HsButton}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#0D3B75" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2A2040"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer stats -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!--                     HEADER                         -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="24,18,24,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E1830" Offset="0"/>
                    <GradientStop Color="#16122A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- HS Dragon icon placeholder -->
                        <TextBlock Text="🐉" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="HEARTHSTONE" FontSize="22" FontWeight="Black" Foreground="#D4AF37"/>
                            <Run Text=" DECK TRACKER" FontSize="22" FontWeight="Light" Foreground="#EAEAEA"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Automatic collection and match sync" FontSize="11"
                               Foreground="#6B6080" Margin="38,2,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" x:Name="BorderStatus" CornerRadius="20" Padding="14,6"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1B4D1E" Offset="0"/>
                            <GradientStop Color="#144016" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#2E7D32"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Waiting for match"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#81C784"/>
                    </StackPanel>
                </Border>
                
                <!-- Language Selector in Top Header -->
                <ComboBox Grid.Column="2" x:Name="ComboLocale"
                          Height="34" Width="145" VerticalContentAlignment="Center"
                          Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="ComboLocale_SelectionChanged">
                    <ComboBox.Background>
                        <SolidColorBrush Color="#1D162A"/>
                    </ComboBox.Background>
                    <ComboBox.Foreground>
                        <SolidColorBrush Color="#FFD700"/>
                    </ComboBox.Foreground>
                    <ComboBox.BorderBrush>
                        <SolidColorBrush Color="#D4AF37"/>
                    </ComboBox.BorderBrush>
                </ComboBox>

                <!-- Web Dashboard Button -->
                <Button Grid.Column="3" x:Name="BtnOpenWebDashboard" Content="🌐 Open Web Dashboard" 
                        Style="{StaticResource HsButton}" 
                        Background="#2A3F7A" 
                        Padding="14,8" Margin="12,0,0,0" 
                        VerticalAlignment="Center" 
                        Click="BtnOpenWebApp_Click"/>
            </Grid>
        </Border>

        <!-- Decorative golden line under header -->
        <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#D4AF37" Offset="0.3"/>
                    <GradientStop Color="#FFD700" Offset="0.5"/>
                    <GradientStop Color="#D4AF37" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ══════════════════════════════════════════════════ -->
        <!--                  MAIN CONTENT                      -->
        <!-- ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,18,24,18">
            <StackPanel Margin="0">

                <!-- Game Detection Card -->
                <Border CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D1930" Offset="0"/>
                            <GradientStop Color="#16132A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A2F5A" Offset="0"/>
                            <GradientStop Color="#241E40" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2A3F7A" Offset="0"/>
                                    <GradientStop Color="#0D1F50" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="HEARTHSTONE" FontSize="11" Foreground="#8880AA"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="TxtGamePathDisplay"
                                       Text="Detecting location..."
                                       FontSize="13" Foreground="#E0D8FF"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Auto-detect status -->
                        <Border Grid.Column="2" x:Name="BorderGameDetected" CornerRadius="12"
                                Padding="10,4" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="#1B4D1E"/>
                            </Border.Background>
                            <TextBlock x:Name="TxtGameDetected" Text="✓ Detected"
                                       FontSize="11" FontWeight="Bold" Foreground="#66BB6A"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Collection Sync Card -->
                <Border CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A2B3A" Offset="0"/>
                            <GradientStop Color="#112030" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#1E3550"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCollectionHeader" Text="Collection Sync" FontSize="15"
                                               FontWeight="Bold" Foreground="#D4E8FF"/>
                                    <TextBlock x:Name="TxtCollectionStatus"
                                               Text="Open collection in game — sync happens automatically"
                                               FontSize="11" Foreground="#7090B0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Hyperlink Click="LinkInstructions_Click" Foreground="#4DA6FF" TextDecorations="Underline">
                                    <Run x:Name="RunInstructions" Text="Instructions ❓"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Single Collection Sync Button -->
                            <Button Grid.Column="0" x:Name="BtnSyncFull"
                                    Content="📥 Sync Collection"
                                    Style="{StaticResource BlueButton}"
                                    Height="40" Click="BtnSyncFull_Click"
                                    ToolTip="Reads and syncs your collection from running Hearthstone game memory"/>

                            <!-- Launch HS Button -->
                            <Button Grid.Column="2" x:Name="BtnLaunchHS"
                                    Height="40" Click="BtnLaunchHS_Click"
                                    Padding="10,0"
                                    Style="{StaticResource HsButton}">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7B1F1F" Offset="0"/>
                                        <GradientStop Color="#4A0F0F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔥" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock x:Name="TxtLaunchBtnLabel" Text="Launch Game" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════ -->
        <!--               FOOTER STATS BAR                     -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="20,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#14102A" Offset="0"/>
                    <GradientStop Color="#0E0C1E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#D4AF37" Offset="0.3"/>
                    <GradientStop Color="#D4AF37" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stat 1: Game detected -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStat1Label" Text="GAME" FontSize="9" FontWeight="Bold" Foreground="#6B5A8A"/>
                        <TextBlock x:Name="TxtStatGame" Text="Detected"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#9E8BC0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stat 2: Collection count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📚" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStat2Label" Text="COLLECTION" FontSize="9" FontWeight="Bold" Foreground="#6B5A8A"/>
                        <TextBlock x:Name="TxtStatCollection" Text="—"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#9E8BC0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stat 3: Tracking status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="👁" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStat3Label" Text="TRACKING" FontSize="9" FontWeight="Bold" Foreground="#6B5A8A"/>
                        <TextBlock x:Name="TxtStatTracking" Text="Active"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#66BB6A"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden controls for C# code-behind backward compatibility -->
        <TextBox x:Name="TxtConsole" Visibility="Collapsed"/>
        <TextBox x:Name="TxtHsPath" Visibility="Collapsed"/>
        <TextBox x:Name="TxtDeckCode" Visibility="Collapsed" TextChanged="TxtDeckCode_TextChanged"/>
        <Button x:Name="BtnSync" Visibility="Collapsed"/>
        <TextBlock x:Name="TxtStatDeck" Visibility="Collapsed"/>
        <ItemsControl x:Name="ItemsDeckPreview" Visibility="Collapsed"/>
        
        <!-- INSTRUCTIONS OVERLAY -->
        <Grid x:Name="GridInstructions" Grid.RowSpan="3" Visibility="Collapsed" Background="#D8000000">
            <Border Background="#1C1830" BorderBrush="#3A2F5A" BorderThickness="1" CornerRadius="12"
                    Width="500" Height="450" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtInstTitle" Text="Collection Sync Instructions" FontSize="18" FontWeight="Bold" Foreground="#D4AF37" Margin="0,0,0,16"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtInstIntro" TextWrapping="Wrap" Foreground="#E0D8FF" FontSize="13" Margin="0,0,0,12">
                                To automatically sync 100% of your owned cards instantly, we utilize Hearthstone game memory scanner.
                            </TextBlock>

                            <TextBlock x:Name="TxtInstStep1Title" Text="Step 1: HDT Required" FontWeight="Bold" Foreground="#D4E8FF" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtInstStep1Body" TextWrapping="Wrap" Foreground="#A098C0" FontSize="12" Margin="0,0,0,8">
                                Make sure you have the free official Hearthstone Deck Tracker (HDT) installed:
                            </TextBlock>
                            
                            <Button x:Name="BtnDownloadHDT" Content="Download Hearthstone Deck Tracker" 
                                    Background="#2E7D32" Foreground="White" BorderThickness="0" 
                                    Padding="10,6" Margin="0,0,0,16" HorizontalAlignment="Left"
                                    Cursor="Hand" Click="BtnDownloadHDT_Click"/>

                            <TextBlock x:Name="TxtInstStep2Title" Text="Step 2: Launch" FontWeight="Bold" Foreground="#D4E8FF" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtInstStep2Body" TextWrapping="Wrap" Foreground="#A098C0" FontSize="12" Margin="0,0,0,16">
                                1. Open Hearthstone.
                                &#x0a;2. Go to "My Collection" in the main menu.
                                &#x0a;3. Sync with Web App will happen automatically, or click "Sync Collection".
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="BtnCloseInstructions" Content="Understood, close" Style="{StaticResource HsButton}"
                            Background="#3A2F5A" Height="36" Margin="0,16,0,0" Click="BtnCloseInstructions_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
