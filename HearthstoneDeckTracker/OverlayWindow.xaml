<Window x:Class="HearthstoneDeckTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone Deck Tracker Overlay" 
        Height="650" Width="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Style for row hover and highlight -->
        <Style x:Key="CardRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#E5140F0A"/>
            <Setter Property="BorderBrush" Value="#40806030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2C2114"/>
                    <Setter Property="BorderBrush" Value="#FFD4AF37"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <!-- Main Hearthstone Frame -->
        <Border Background="#F2120C07" 
                BorderBrush="#D4AF37" 
                BorderThickness="2" 
                CornerRadius="10" 
                Padding="8"
                Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="Black" Opacity="0.8"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header / Hearthstone Emblem Ribbon -->
                <Border Grid.Row="0" Background="#FF1E160F" BorderBrush="#80C5A059" BorderThickness="0,0,0,1.5" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔ " Foreground="#FFD4AF37" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDeckHeader" Text="TALIA GRACZA" Foreground="#FFE893" FontSize="12" FontWeight="Black" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        
                        <Border Grid.Column="1" Background="#3D2912" BorderBrush="#A67D3B" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtDeckCount" Text="30/30" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Cards List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsDeckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="1" Height="36" Opacity="{Binding CardOpacity}" Cursor="Hand"
                                      MouseEnter="CardRow_MouseEnter" MouseLeave="CardRow_MouseLeave">
                                    
                                    <!-- Row Border & Hover container -->
                                    <Border Style="{StaticResource CardRowStyle}"/>
                                    
                                    <!-- Card Tile Crop Image -->
                                    <Image Source="{Binding TilePath}" Stretch="UniformToFill" HorizontalAlignment="Right" Width="170" Opacity="0.75"/>
                                    
                                    <!-- Dark Gradient Text Overlay -->
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#FF0E0A07" Offset="0.0"/>
                                                <GradientStop Color="#F00E0A07" Offset="0.45"/>
                                                <GradientStop Color="#000E0A07" Offset="0.95"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Card Content Grid -->
                                    <Grid Margin="5,0,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Hearthstone Mana Gem -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center" Width="22" Height="22" Margin="0,0,5,0">
                                            <Polygon Points="11,0 22,11 11,22 0,11" Fill="#FF0070DD" Stroke="#FF003F7A" StrokeThickness="1"/>
                                            <TextBlock Text="{Binding Cost}" Foreground="White" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black" Opacity="1"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Card Name -->
                                        <TextBlock Text="{Binding Name}" Foreground="#F5EBDC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black" Opacity="0.9"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <!-- Draw Odds % -->
                                        <TextBlock Text="{Binding DrawChanceText}" Foreground="#FFC107" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Grid.Column="2" Margin="4,0,6,0"/>

                                        <!-- Count badge -->
                                        <Border Background="#FFD4AF37" BorderBrush="#805C461A" BorderThickness="1" CornerRadius="3" Padding="4,2" VerticalAlignment="Center" Grid.Column="3" MinWidth="22" Height="18">
                                            <TextBlock Text="{Binding CountText}" Foreground="#140D05" FontWeight="Black" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>


        <!-- Floating Card Preview Popup (Transparent, 2x larger cut card) -->
        <Popup x:Name="CardPreviewPopup" Placement="Left" VerticalOffset="-100" HorizontalOffset="-10" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="False">
            <Grid Width="340" Height="480">
                <Image x:Name="ImgCardPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="Black" Opacity="0.9"/>
                    </Image.Effect>
                </Image>
            </Grid>
        </Popup>
    </Grid>
</Window>

