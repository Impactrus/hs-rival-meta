<Window x:Class="HSRivalPlugin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Rival Meta Plugin Settings" Height="340" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0f172a">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            {/* Title */}
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚔️ HS Rival Meta Sync Settings" FontSize="18" FontWeight="Bold" Foreground="#f8fafc"/>
            </StackPanel>

            {/* UserToken Field */}
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="User Token (skopiuj ze strony hs-rival-meta.onrender.com > Kolekcja):" 
                           FontSize="12" Foreground="#94a3b8" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUserToken" Padding="8" FontSize="13" Background="#1e293b" Foreground="#86efac" 
                         BorderBrush="#334155" BorderThickness="1"/>
            </StackPanel>

            {/* Server URL Field */}
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Server URL:" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtServerUrl" Padding="8" FontSize="13" Background="#1e293b" Foreground="#cbd5e1" 
                         BorderBrush="#334155" BorderThickness="1"/>
            </StackPanel>

            {/* Status text */}
            <TextBlock Grid.Row="3" x:Name="TxtStatus" FontSize="12" Foreground="#e2e8f0" TextWrapping="Wrap" Margin="0,4,0,0"/>

            {/* Action Buttons */}
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnSyncNow" Content="🔄 Sync Now" Click="BtnSyncNow_Click" 
                        Padding="14,6" Margin="0,0,8,0" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button x:Name="BtnSave" Content="Save &amp; Close" Click="BtnSave_Click" 
                        Padding="14,6" Background="#16a34a" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
